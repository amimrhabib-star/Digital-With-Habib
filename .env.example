# Standalone Node hosting. Generate ADMIN_PASSWORD_HASH with npm run setup.
ADMIN_PASSWORD_HASH=
NODE_ENV=production
COOKIE_SECURE=true
APP_ORIGIN=
# Set an absolute private durable directory supplied by your host.
STORAGE_DIR=
# Host-managed deployments may supply PORT automatically.
PORT=3000
# DOMAIN is used only by the included Docker Compose configuration.
DOMAIN=
